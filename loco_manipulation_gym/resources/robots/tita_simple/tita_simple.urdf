    <collision>
      <origin rpy="0 0 -0.131" xyz="0.1 0.021 -0.002"/>
      <geometry>
        <box size="0.2 0.07 0.05"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_knee" type="fixed">
    <origin rpy="0 0 -1.5" xyz="0.2 0 0"/>
    <parent link="right_thigh"/>
    <child link="right_shin"/>
  </joint>
  <link name="right_wheel">
    <inertial>
      <origin rpy="0 0 0" xyz="-2.3798E-06 -1.5854E-06 0.00095595"/>
      <mass value="1.5094"/>
      <inertia ixx="0.0035465" ixy="7.0548E-06" ixz="2.3146E-07" iyy="0.0035052" iyz="1.9287E-08" izz="0.0069047"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/right_leg_4.STL"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.034" radius="0.0925"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_ankle" type="fixed">
    <origin rpy="0 0 0" xyz="0.2 0 -0.0514"/>
    <parent link="right_shin" />
    <child link="right_wheel" />
  </joint>

    <!-- arm -->
  <joint name="trunk_arm_joint_base_0" type="fixed" dont_collapse="true" >
    <origin xyz="0.0 0 0.1" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="arm_link00" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="arm_link00">
    <inertial>
      <origin xyz="-2.9972E-05 3.056E-05 0.027301" rpy="0 0 0"/>
      <mass value="0.44038"/>
      <inertia ixx="0.00017" ixy="0.00000" ixz="0.00000" iyy="0.00018" iyz="0.00000" izz="0.00016"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/arm_base.STL" />
      </geometry>
      <material name="">
                <color rgba="0.75294 0.75294 0.75294 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/arm_base.STL" />
      </geometry>
    </collision>
  </link>
  <link name="arm_link01">
    <inertial>
      <origin xyz="0.0060953 -0.0042968 0.017959" rpy="0 0 0"/>
      <mass value="0.060835"/>
      <inertia ixx="0.00008" ixy="0.00000" ixz="0.00001" iyy="0.00003" iyz="0.00000" izz="0.00007"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
