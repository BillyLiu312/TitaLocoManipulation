      <geometry>
        <mesh filename="../meshes/link1.STL" />
      </geometry>
    </collision>
  </link>
  <joint name="arm_joint00" type="revolute">
    <origin xyz="0 0 0.0603" rpy="0 0 0"/>
    <parent link="arm_link00" />
    <child link="arm_link01" />
    <axis xyz="0 0 1" />
    <limit lower="-10" upper="10" effort="100" velocity="1000" />
  </joint>
  <link
    name="arm_link02">
    <inertial>
      <origin xyz="-0.13238 0.0022038 0.00011179" rpy="0 0 0"/>
      <mass value="1.0733"/>
