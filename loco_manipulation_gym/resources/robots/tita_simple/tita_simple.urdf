<?xml version="1.0" encoding="utf-8"?>
<robot name="tita_simple">
  <mujoco>
    <compiler 
      meshdir="meshes/" 
      balanceinertia="true" 
      discardvisual="false" />
  </mujoco>
  <!-- material -->
    <material name="black">
    <color rgba="0.19607843137254902 0.19607843137254902 0.19607843137254902 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.9137254901960784 0.9137254901960784 0.8470588235294118 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4235294117647059 0.0392156862745098 1.0"/>
  </material>
  <material name="brown">
    <color rgba="0.8705882352941177 0.8117647058823529 0.7647058823529411 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <material name="bright_yellow">
    <color rgba="1.0 1.0 0.0 1.0" />
  </material>

  <!-- world base -->
  <link name="world" />
  <link name="virtual_base">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.000483" ixy="0" ixz="0" iyy="0.001004" iyz="0" izz="0.001354"/>
    </inertial>
  </link>
  <joint name="base_motion" type="planar">  <!-- MuJoCo 特有的 planar 类型 -->
    <parent link="world" />
    <child link="virtual_base" />
    <axis xyz="1 0 0" />  <!-- x 方向平移 -->
    <axis2 xyz="0 0 1" /> <!-- z 方向旋转 -->
    <limit effort="100" lower="-100" upper="100" velocity="100"/>
  </joint>
  <joint name="base_to_virtual" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="virtual_base" />
    <child link="base_link" />
  </joint>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0.020452 3.5457E-06 0.01871"/>
      <mass value="13.2"/>
      <inertia ixx="0.061855" ixy="-2.6029E-05" ixz="0.00081082" iyy="0.036934" iyz="-1.7269E-05" izz="0.071232"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../meshes/base_link.STL" />
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.017"/>
      <geometry>
        <box size="0.47 0.3 0.19"/>
      </geometry>
    </collision>
  </link>
  <link name="right_leg_base">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0016025 5.0253E-05 0.000638"/>
      <mass value="2.064"/>
      <inertia ixx="0.0043044" ixy="1.3538E-07" ixz="-8.054E-05" iyy="0.0029982" iyz="-1.5359E-06" izz="0.0022703"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/right_leg_1.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="right_leg_joint_base" type="fixed" dont_collapse="true" >
    <origin rpy="1.5708 0 1.5708" xyz="0 -0.0895 0"/>
    <parent link="base_link" />
    <child link="right_leg_base" />
    <axis xyz="0 0 0" />
  </joint>
  <link name="left_leg_base">
    <inertial>
      <origin rpy="0 0 0" xyz="0.0016025 5.0253E-05 0.000638"/>
      <mass value="2.064"/>
      <inertia ixx="0.0043044" ixy="-1.3538E-07" ixz="8.054E-05" iyy="0.0029982" iyz="-1.5446E-06" izz="0.0022703"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/left_leg_1.STL"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="left_leg_joint_base" type="fixed" dont_collapse="true" >
    <origin rpy="1.5708 0 1.5708" xyz="0 0.0895 0"/>
    <parent link="base_link" />
    <child link="left_leg_base" />
    <axis xyz="0 0 0" />
  </joint>
  

  

  <!-- right leg -->
  <link name="right_thigh">
    <inertial>
      <origin rpy="0 0 0" xyz="0.021763 0.0019065 0.027873"/>
      <mass value="3.0987"/>
      <inertia ixx="0.0029784" ixy="-9.6347E-05" ixz="-7.8776E-05" iyy="0.0064836" iyz="-4.3711E-06" izz="0.0088353"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/right_leg_2.STL"/>
      </geometry>
      <material name="bright_yellow"/>
    </visual>
  </link>
  <joint name="right_hip" type="fixed">
    <origin rpy="-1.5708 0 -0.7708" xyz="-0.1426 0 0"/>
    <parent link="right_leg_base"/>
    <child link="right_thigh"/>
  </joint>
  <link name="right_shin">
    <inertial>
      <origin rpy="0 0 0" xyz="0.095348 0.011698 -0.001838"/>
      <mass value="0.57244"/>
      <inertia ixx="0.00030595" ixy="0.00035537" ixz="0.00011764" iyy="0.0032009" iyz="-1.129E-05" izz="0.0034209"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/right_leg_3.STL"/>
      </geometry>
